/* ---- image capture upload + preview (file select or clipboard paste) ---- */
function loadImageFile(file, previewId, placeholderId){
  if(!file) return;
  const preview=$(previewId), placeholder=$(placeholderId);
  const reader=new FileReader();
  reader.onload = e=>{
    preview.src = e.target.result;
    preview.style.display='block';
    placeholder.style.display='none';
  };
  reader.readAsDataURL(file);
}
function bindCaptureUpload(inputId, previewId, placeholderId){
  const input=$(inputId);
  input.addEventListener('change', ()=>{
    loadImageFile(input.files && input.files[0], previewId, placeholderId);
  });
}
