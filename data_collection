document.addEventListener('paste', (e)=>{
  const activeEl = document.activeElement;
  const withinDropZone = activeEl && (activeEl.id==='img1Drop' || activeEl.id==='img2Drop');
  if(!withinDropZone) return;
  const items = e.clipboardData && e.clipboardData.items;
  if(!items) return;
  for(const item of items){
    if(item.type.indexOf('image')===0){
      const file = item.getAsFile();
      if(activeCaptureTarget==='1') loadImageFile(file, 'img1Preview', 'img1Placeholder');
      else loadImageFile(file, 'img2Preview', 'img2Placeholder');
      e.preventDefault();
      break;
    }
  }
});

/* ---- build a self-contained submission PDF (browser print, no external libs) ---- */
function setSubmitStatus(msg, isError){
