/* ---- minimal PDF writer (no external libraries): embeds JPEG canvases as full-bleed pages ---- */
function dataUrlToBytes(dataUrl){
  const base64 = dataUrl.split(',')[1];
  const binary = atob(base64);
  const bytes = new Uint8Array(binary.length);
  for(let i=0;i<binary.length;i++) bytes[i] = binary.charCodeAt(i);
  return bytes;
}
function buildPdfBytes(pages){
  const enc = new TextEncoder();
  let offset = 0;
  const parts = [];
  const objOffsets = {};
  function push(strOrBytes){
    const bytes = (typeof strOrBytes === 'string') ? enc.encode(strOrBytes) : strOrBytes;
    parts.push(bytes);
    offset += bytes.length;
  }
  push('%PDF-1.4\n');
  push(new Uint8Array([0x25,0xE2,0xE3,0xCF,0xD3,0x0A]));

  const N = pages.length;
  const pageObjNums = [];
  for(let k=0;k<N;k++){
    const pageObjNum = 3 + k*3, contentObjNum = 4 + k*3, imageObjNum = 5 + k*3;
    pageObjNums.push(pageObjNum);
    const p = pages[k];
    const contentStr = `q\n${p.pageWidthPt.toFixed(2)} 0 0 ${p.pageHeightPt.toFixed(2)} 0 0 cm\n/Im0 Do\nQ`;
    const contentBytes = enc.encode(contentStr);

    objOffsets[pageObjNum] = offset;
    push(`${pageObjNum} 0 obj\n<< /Type /Page /Parent 2 0 R /MediaBox [0 0 ${p.pageWidthPt.toFixed(2)} ${p.pageHeightPt.toFixed(2)}] /Resources << /XObject << /Im0 ${imageObjNum} 0 R >> >> /Contents ${contentObjNum} 0 R >>\nendobj\n`);

    objOffsets[contentObjNum] = offset;
    push(`${contentObjNum} 0 obj\n<< /Length ${contentBytes.length} >>\nstream\n`);
    push(contentBytes);
    push('\nendstream\nendobj\n');

    objOffsets[imageObjNum] = offset;
    push(`${imageObjNum} 0 obj\n<< /Type /XObject /Subtype /Image /Width ${p.width} /Height ${p.height} /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /DCTDecode /Length ${p.jpegBytes.length} >>\nstream\n`);
    push(p.jpegBytes);
    push('\nendstream\nendobj\n');
  }

  objOffsets[2] = offset;
  push(`2 0 obj\n<< /Type /Pages /Kids [ ${pageObjNums.map(n=>n+' 0 R').join(' ')} ] /Count ${N} >>\nendobj\n`);
  objOffsets[1] = offset;
  push(`1 0 obj\n<< /Type /Catalog /Pages 2 0 R >>\nendobj\n`);

  const xrefStart = offset;
  const maxObjNum = 2 + 3*N;
  let xref = `xref\n0 ${maxObjNum+1}\n0000000000 65535 f \n`;
  for(let num=1; num<=maxObjNum; num++){
    xref += `${String(objOffsets[num]).padStart(10,'0')} 00000 n \n`;
  }
  push(xref);
  push(`trailer\n<< /Size ${maxObjNum+1} /Root 1 0 R >>\nstartxref\n${xrefStart}\n%%EOF`);

  const total = parts.reduce((s,p)=>s+p.length,0);
  const result = new Uint8Array(total);
  let pos=0;
  for(const p of parts){ result.set(p,pos); pos+=p.length; }
  return result;
}
function canvasToPdfPage(canvas){
  const jpegBytes = dataUrlToBytes(canvas.toDataURL('image/jpeg', 0.9));
  const PT_PER_PX = 0.75;
  return {
    jpegBytes, width: canvas.width, height: canvas.height,
    pageWidthPt: canvas.width*PT_PER_PX, pageHeightPt: canvas.height*PT_PER_PX
  };
}

/* ---- draw each section onto its own canvas using plain Canvas 2D (no DOM rendering libs) ---- */
function wrapCanvasText(ctx, text, maxWidth){
  const paragraphs = text.split('\n');
  const lines = [];
  paragraphs.forEach(para=>{
    if(para===''){ lines.push(''); return; }
    let line='';
    for(const ch of para){
      const test = line+ch;
      if(ctx.measureText(test).width > maxWidth && line!==''){
        lines.push(line);
        line = ch;
      }else{
        line = test;
      }
    }
    lines.push(line);
  });
  return lines;
}
function buildImagePageCanvas(title, meta, label, imgEl){
  const W=1000, margin=48;
  const availW = W - margin*2;
  const scale = availW / imgEl.naturalWidth;
  const imgW = availW, imgH = imgEl.naturalHeight*scale;
  const titleH = title ? 40 : 0;
  const metaH = meta ? 26 : 0;
  const labelH = 34;
  const topH = margin + titleH + metaH + labelH;
  const canvas = document.createElement('canvas');
  canvas.width = W;
  canvas.height = topH + imgH + margin;
  const ctx = canvas.getContext('2d');
  ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,canvas.width,canvas.height);
  let y = margin;
  if(title){
    ctx.fillStyle='#1F2430'; ctx.font='700 26px "IBM Plex Sans KR", sans-serif';
    ctx.fillText(title, margin, y+24);
    y += titleH;
  }
  if(meta){
    ctx.fillStyle='#6B7280'; ctx.font='400 15px "IBM Plex Sans KR", sans-serif';
    ctx.fillText(meta, margin, y+16);
    y += metaH;
  }
  ctx.fillStyle='#1F2430'; ctx.font='600 18px "IBM Plex Sans KR", sans-serif';
  ctx.fillText(label, margin, y+22);
  y += labelH;
  ctx.drawImage(imgEl, margin, y, imgW, imgH);
  ctx.strokeStyle='#E3E6F0'; ctx.lineWidth=2;
  ctx.strokeRect(margin, y, imgW, imgH);
  return canvas;
}
function buildTextPageCanvas(label, text){
  const W=1000, margin=48, boxPad=22, lineHeight=26;
  const canvas0 = document.createElement('canvas');
  const ctx0 = canvas0.getContext('2d');
  ctx0.font='16px "IBM Plex Sans KR", sans-serif';
  const maxTextWidth = (W - margin*2) - boxPad*2;
  const lines = wrapCanvasText(ctx0, text, maxTextWidth);
  const labelH=44;
  const boxH = lines.length*lineHeight + boxPad*2;
  const canvas = document.createElement('canvas');
  canvas.width = W;
  canvas.height = margin + labelH + boxH + margin;
  const ctx = canvas.getContext('2d');
  ctx.fillStyle='#ffffff'; ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.fillStyle='#1F2430'; ctx.font='600 18px "IBM Plex Sans KR", sans-serif';
  ctx.fillText(label, margin, margin+22);
  const boxY = margin+labelH;
  ctx.fillStyle='#F5F6FB'; ctx.fillRect(margin, boxY, W-margin*2, boxH);
  ctx.strokeStyle='#E3E6F0'; ctx.lineWidth=2; ctx.strokeRect(margin, boxY, W-margin*2, boxH);
  ctx.fillStyle='#1F2430'; ctx.font='16px "IBM Plex Sans KR", sans-serif';
  lines.forEach((line,i)=>{ ctx.fillText(line, margin+boxPad, boxY+boxPad+18+i*lineHeight); });
  return canvas;
}

function escapeHtml(str){
  return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
async function buildSubmissionFile(){
  const name = $('studentNameInput').value.trim();
  const img1El = $('img1Preview');
  const img2El = $('img2Preview');
  const analysis = $('analysisText').value.trim();

  if(!name){ setSubmitStatus('이름을 입력해주세요.', true); return; }
  if(img1El.style.display==='none'){ setSubmitStatus('10년 전 캡처 이미지를 첨부해주세요.', true); return; }
  if(img2El.style.display==='none'){ setSubmitStatus('올해 캡처 이미지를 첨부해주세요.', true); return; }
  if(!analysis){ setSubmitStatus('분석 결과를 작성해주세요.', true); return; }

  setSubmitStatus('PDF를 만드는 중이에요. 잠시만 기다려주세요...', false);

  try{
    if(document.fonts && document.fonts.ready){ await document.fonts.ready; }

    const meta = `제출자: ${name} · 제출일: ${new Date().toLocaleString('ko-KR')}`;
    const page1 = buildImagePageCanvas('🌡️ 기온 변화 조사 제출', meta, '10년 전 캡처', img1El);
    const page2 = buildImagePageCanvas(null, null, '올해 캡처', img2El);
    const page3 = buildTextPageCanvas('분석 결과', analysis);

    const pdfBytes = buildPdfBytes([page1, page2, page3].map(canvasToPdfPage));
    const blob = new Blob([pdfBytes], {type:'application/pdf'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `기온변화_제출_${name}.pdf`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    setSubmitStatus('PDF 파일이 다운로드되었어요. 안내된 방법으로 업로드해서 제출을 완료해주세요.', false);
  }catch(err){
    setSubmitStatus('PDF 생성 중 문제가 발생했어요. 페이지를 새로고침한 뒤 다시 시도해주세요.', true);
  }
}

